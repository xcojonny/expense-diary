# Production configuration for deploy/docker-compose.yml. Copy to deploy/.env.

# Container image coordinates (GitHub Container Registry).
GHCR_OWNER=your-github-user
IMAGE_TAG=latest

# Public host Traefik routes on (used by the traefik labels in docker-compose.yml).
APP_HOST=haushaltsbuch.example.org

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=expense
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=expense

# --- Backend (app.core.config.Settings) --------------------------------------
APP_ENV=production
BASE_URL=https://haushaltsbuch.example.org
API_BASE_URL=https://haushaltsbuch.example.org
SECRET_KEY=generate-a-strong-32+-byte-secret
DATABASE_URL=postgresql+asyncpg://expense:change-me-please@db:5432/expense
REDIS_URL=redis://redis:6379/0
MEDIA_DIR=/data/media
DEFAULT_LOCALE=de

# Auth & tenancy
INITIAL_ADMIN_EMAIL=admin@example.org
COOKIE_SECURE=true

# SMTP for magic-link / invitation mail
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=haushaltsbuch@example.org
MAIL_FROM_NAME=Haushaltsbuch

# OIDC SSO via Authelia (empty issuer disables it). Redirect URI in Authelia:
#   {API_BASE_URL}/api/v1/auth/oidc/callback
OIDC_ISSUER=https://auth.example.org
OIDC_CLIENT_ID=expense-diary
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Authelia
OIDC_SCOPES=openid email profile

# --- Vision LLM for receipt extraction ---------------------------------------
# none = rule-based/no-op fallback. See backend/.env.example for the options.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90

# No host ports are published: Traefik (see the traefik labels in
# docker-compose.yml) reaches backend:8000 / frontend:8080 over the `proxy`
# network and terminates TLS on APP_HOST.
