# Deploy webhook (infra/docker-compose.infra.yml). Copy to infra/.env.

# Must match the GitHub repo secret DEPLOY_WEBHOOK_SECRET (used to HMAC-sign
# the release deploy request).
DEPLOY_WEBHOOK_SECRET=generate-a-strong-random-secret

# Absolute path to the app stack directory (the one with docker-compose.yml + .env).
APP_DEPLOY_DIR=/srv/expense

# Optional ntfy topic URL for deploy success/failure notifications.
NTFY_URL=

# Host port the webhook listens on (front it with your reverse proxy + TLS).
WEBHOOK_PORT=9000
