# Vorlage für .env — kopieren und anpassen:
#   cp .env.example .env
#
# Alle Werte haben brauchbare Defaults; Pflicht in Produktion sind nur
# SECRET_KEY und AUTH_PASSWORD.

APP_ENV=production

# --- Anmeldung (ADR-004) -----------------------------------------------------
# Ein Haushalt oder mehrere? Das entscheidet der Modus:
#
# password        = ein Passwort, Session als httpOnly-Cookie (Default).
#                   EIN Haushalt — keine Einladungen, keine weiteren Nutzer.
# oidc            = Single Sign-on gegen einen Identity Provider. MEHRERE
#                   Nutzer und Haushalte, Einladungen möglich.
# trusted_header  = ein Reverse Proxy authentifiziert (Authelia, authentik,
#                   Traefik Forward-Auth) und setzt AUTH_TRUSTED_HEADER.
#                   MEHRERE Nutzer und Haushalte.
# none            = kein Schutz, nur für rein lokale Nutzung. EIN Haushalt.
AUTH_MODE=password

# Nur bei AUTH_MODE=password.
AUTH_PASSWORD=bitte-aendern

# Signiert das Session-Cookie. Erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Fehlt der Wert, sind Sessions nach jedem Neustart ungültig.
SECRET_KEY=

# true, sobald HTTPS davor steht (praktisch immer in Produktion).
COOKIE_SECURE=true

# Öffentliche Adresse der Instanz. Wird für den OIDC-Redirect und für
# Einladungslinks gebraucht — hinter einem Proxy also auf die echte URL setzen,
# sonst zeigen die Links nach localhost.
# BASE_URL=https://haushalt.example.org

# Nur bei AUTH_MODE=trusted_header:
# ACHTUNG — der Proxy MUSS diesen Header überschreiben. Tut er das nicht, kann
# jeder Client ihn selbst mitschicken und ist damit angemeldet.
# AUTH_TRUSTED_HEADER=Remote-User
# Optional, für einen sprechenden Namen in der Mitgliederliste:
# AUTH_TRUSTED_EMAIL_HEADER=Remote-Email

# --- Single Sign-on (nur bei AUTH_MODE=oidc, ADR-014) -------------------------
# Alle drei sind Pflicht, sonst startet die App in Produktion nicht.
# Als Redirect-URI beim Provider eintragen:
#   <BASE_URL>/api/auth/oidc/callback
# OIDC_ISSUER=https://auth.example.org/application/o/haushaltsbuch/
# OIDC_CLIENT_ID=haushaltsbuch
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile

# --- Einladungsmails (optional, ADR-013) -------------------------------------
# Ohne SMTP_HOST wird keine Mail verschickt: der Einladungslink erscheint dann
# in der Oberfläche zum Weitergeben und steht im Log. Es geht also nichts
# verloren, wenn dieser Block leer bleibt.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=haushaltsbuch@example.org
# SMTP_STARTTLS=true
# Gültigkeitsdauer einer Einladung in Stunden (Default 168 = 7 Tage).
# INVITATION_TTL_HOURS=168

# --- Ablage ------------------------------------------------------------------
# SQLite-Datei und Belege. Im Container das Volume, lokal ein Ordner.
DATA_DIR=/data

# --- Texterkennung (optional) ------------------------------------------------
# Ohne Modell funktioniert die App weiter: digitale eBon-PDFs werden vom
# eingebauten Parser gelesen, Fotos landen zum manuellen Erfassen unter
# „Prüfen“. Es geht also nichts kaputt, wenn dieser Block leer bleibt.
#
# LLM_PROVIDER: none | openai | openrouter | ollama
LLM_PROVIDER=none
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# Basis-URL nur setzen, wenn sie vom Provider-Default abweicht:
#   openai      https://api.openai.com/v1
#   openrouter  https://openrouter.ai/api/v1
#   ollama      http://localhost:11434/v1
# LLM_BASE_URL=
# Fotos werden vor dem Versand auf diese Kantenlänge verkleinert (spart Tokens).
# LLM_MAX_IMAGE_PX=1600

# --- Feinheiten ---------------------------------------------------------------
# UPLOAD_MAX_BYTES=15728640
# LOG_LEVEL=INFO
# LOG_FORMAT=json          # text | json
# WORKER_MAX_ATTEMPTS=3
# SESSION_TTL_HOURS=720

# --- docker-compose -----------------------------------------------------------
# Host-Port; hinter einem Reverse Proxy besser 127.0.0.1 binden (siehe compose).
HOST_PORT=8000
# Fertiges Image statt lokalem Build:
# IMAGE=ghcr.io/xcojonny/expense-diary:latest
