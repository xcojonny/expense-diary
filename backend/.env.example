# Backend configuration for local (non-Docker) development.
# Copy to backend/.env (make install does this) and adjust as needed.
# In Docker these are provided via deploy/.env; MEDIA_DIR becomes /data/media.

APP_ENV=development
# Dev uses non-standard ports (see Makefile / docker-compose.dev.yml).
BASE_URL=http://localhost:3010
API_BASE_URL=http://localhost:8010

# JWT signing — generate a strong value for anything but throwaway local dev:
#   openssl rand -base64 48
#   # or:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-use-at-least-32-random-bytes

# Matches docker-compose.dev.yml (Postgres on host :55432, Redis on :56379).
DATABASE_URL=postgresql+asyncpg://expense:expense@localhost:55432/expense
REDIS_URL=redis://localhost:56379/0

# Uploaded receipt images/PDFs. Relative path for local dev.
MEDIA_DIR=./.data/media

DEFAULT_LOCALE=de

# --- Auth & tenancy ----------------------------------------------------------
# Bootstrapped on startup as active instance admin + owner of the default group.
# Request a magic link for this address to log in the first time.
INITIAL_ADMIN_EMAIL=admin@example.org
COOKIE_SECURE=false  # true in production (HTTPS); false for plain-HTTP local dev
# Magic-link browser-binding. Off (default) = simple click-to-login: the
# single-use, short-lived link logs you in wherever it's opened — the setting a
# trusted homelab wants, since mobile mail apps open the link in a separate
# in-app browser (different cookie jar) and would otherwise force a pairing-code
# dead-end. Set true only to harden a shared/multi-user instance.
MAGIC_LINK_REQUIRE_SAME_BROWSER=false

# --- SMTP (magic-link / invitation mail) -------------------------------------
# Leave SMTP_HOST empty in dev → the link is logged to the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=haushaltsbuch@example.org
MAIL_FROM_NAME=Haushaltsbuch

# --- OIDC SSO (Authelia or any OIDC provider) --------------------------------
# Empty OIDC_ISSUER hides the SSO button. Register a confidential client in
# Authelia with redirect URI {API_BASE_URL}/api/v1/auth/oidc/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Authelia
OIDC_SCOPES=openid email profile

# --- Vision LLM for receipt extraction ---------------------------------------
# Provider-agnostic adapter. "none" = rule-based/no-op fallback (receipts land
# in needs_review instead of done), so the app runs with no LLM configured.
#   openai  → any OpenAI-Vision-compatible endpoint (set LLM_BASE_URL + key)
#   ollama  → local Ollama (e.g. LLM_BASE_URL=http://localhost:11434/v1)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90
