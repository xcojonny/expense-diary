# Backend configuration for local (non-Docker) development.
# Copy to backend/.env (make install does this) and adjust as needed.
# In Docker these are provided via deploy/.env; MEDIA_DIR becomes /data/media.

APP_ENV=development
BASE_URL=http://localhost:3000

# Matches docker-compose.dev.yml (Postgres on :5432, Redis on :6379).
DATABASE_URL=postgresql+asyncpg://expense:expense@localhost:5432/expense
REDIS_URL=redis://localhost:6379/0

# Uploaded receipt images/PDFs. Relative path for local dev.
MEDIA_DIR=./.data/media

DEFAULT_LOCALE=de

# --- Vision LLM for receipt extraction ---------------------------------------
# Provider-agnostic adapter. "none" = rule-based/no-op fallback (receipts land
# in needs_review instead of done), so the app runs with no LLM configured.
#   openai  → any OpenAI-Vision-compatible endpoint (set LLM_BASE_URL + key)
#   ollama  → local Ollama (e.g. LLM_BASE_URL=http://localhost:11434/v1)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90
